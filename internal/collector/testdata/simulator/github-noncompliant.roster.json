{
  "version": 1,
  "vendor": "github",
  "source": "terraform/, checklist.md and the organization's hand-set state, as expectations.yaml's notes describe them. The organization is named by the recordings' test-org, since its login stays out of this repository.",
  "providers": {"vcs-posture": "github", "access-posture": "github", "vuln-scanning": "github"},
  "accounts": {
    "owner": {"kind": "member", "enabled": true, "roles": ["admin"], "mfa": "two_factor", "logins": "password"}
  },
  "unsettled": {"owner": ["signed_in"]},
  "apps": {
    "collector": {"enabled": true, "publisher": "this_organization", "registered": "checklist.md step 8, only on this account"}
  },
  "vcs": {
    "organization": "test-org",
    "two_factor_requirement": false,
    "include_patterns": ["*"],
    "exclude_patterns": ["scratch-*"],
    "repositories": {
      "classic-pr-required": {
        "protections": {
          "classic": {"enforcement": "active", "rules": {"required_pull_request_reviews": {"approvals": 1}, "block_force_pushes": {}, "block_deletions": {}}}
        }
      },
      "ruleset-pr-no-approvals": {
        "protections": {
          "classic": {"enforcement": "active", "rules": {"required_linear_history": {}}},
          "ruleset:require-pull-request": {"enforcement": "active", "rules": {"pull_request": {"approvals": 0}, "deletion": {}, "non_fast_forward": {}}}
        }
      },
      "ruleset-disabled": {
        "protections": {
          "ruleset:require-pull-request": {"enforcement": "disabled", "rules": {"pull_request": {"approvals": 1}, "deletion": {}, "non_fast_forward": {}}}
        }
      },
      "classic-no-pr": {
        "protections": {
          "classic": {"enforcement": "active", "rules": {"block_force_pushes": {}, "block_deletions": {}}}
        }
      },
      "unprotected": {},
      "scratch-notes": {},
      "not-installed": {"collector_access": false}
    }
  },
  "scanning": {
    "resources": {
      "classic-pr-required": {"type": "repository", "scans": {"Dependabot alerts": "enabled", "Code scanning": "configured", "Secret scanning": "enabled"}},
      "ruleset-pr-no-approvals": {"type": "repository", "scans": {"Dependabot alerts": "enabled", "Code scanning": "configured", "Secret scanning": "enabled"}},
      "ruleset-disabled": {"type": "repository", "scans": {"Dependabot alerts": "disabled", "Code scanning": "configured", "Secret scanning": "enabled"}},
      "classic-no-pr": {"type": "repository", "scans": {"Dependabot alerts": "disabled", "Code scanning": "not-configured", "Secret scanning": "enabled"}},
      "unprotected": {"type": "repository", "scans": {"Dependabot alerts": "disabled", "Code scanning": "not-configured", "Secret scanning": "disabled"}},
      "scratch-notes": {"type": "repository", "scans": {"Dependabot alerts": "disabled", "Code scanning": "not-configured", "Secret scanning": "disabled"}},
      "not-installed": {"type": "repository", "scans": {"Dependabot alerts": "disabled", "Code scanning": "not-configured", "Secret scanning": "disabled"}}
    }
  },
  "terms": {
    "account_kinds": {"member": "member", "outside_collaborator": "guest"},
    "roles": {"admin": "admin", "member": "none"},
    "mfa_methods": {"two_factor": "mfa"},
    "login_methods": {"password": "local", "saml": "sso"},
    "app_publishers": {"this_organization": "organization", "other_account": "third_party"},
    "vcs_enforcements": {"active": "enforced", "evaluate": "report_only", "disabled": "off"},
    "vcs_rules": {
      "required_pull_request_reviews": "pull_request",
      "pull_request": "pull_request",
      "required_status_checks": "status_checks",
      "required_signatures": "signed_commits",
      "required_linear_history": "other",
      "block_force_pushes": "other",
      "block_deletions": "other",
      "deletion": "other",
      "non_fast_forward": "other"
    },
    "vuln_scanners": {
      "Dependabot alerts": {"name": "dependabot", "categories": {"repository": "dependencies"}},
      "Code scanning": {"name": "code_scanning", "categories": {"repository": "code"}},
      "Secret scanning": {"name": "secret_scanning", "categories": {"repository": "secrets"}}
    },
    "vuln_scan_statuses": {"enabled": "scanned", "disabled": "not_scanned", "configured": "scanned", "not-configured": "not_scanned"},
    "vuln_severities": {"critical": "critical", "high": "high", "medium": "medium", "low": "low"},
    "vuln_finding_states": {"open": "open", "fixed": "closed", "dismissed": "closed"}
  }
}

