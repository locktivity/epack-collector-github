{
  "id": 2001,
  "name": "Default branch baseline",
  "target": "branch",
  "source_type": "Organization",
  "source": "test-org",
  "enforcement": "active",
  "conditions": {
    "ref_name": {"exclude": [], "include": ["~DEFAULT_BRANCH"]},
